# ============================================================
# SC Mais Inovação · Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais
# ============================================================

# Chave da API Gemini (Google AI Studio / Gemini Developer API)
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# (Opcional) Modelo do Gemini — padrão: gemini-2.5-flash
# Opções recomendadas para free tier: gemini-2.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# Chave da API do Firecrawl (para validação em tempo real)
# Obtenha em: https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=fc-...

# Porta do servidor — Hostinger costuma rodar na PORT que ele injeta
PORT=3000

# (Opcional) Token para proteger /api/refresh-cache e /api/audit/*
ADMIN_TOKEN=

# (Opcional) Salt usado para hashear IPs no log de auditoria.
# Se não definir, é gerado um salt aleatório no boot (mas isso impede
# correlacionar IPs entre reinicializações). Para retenção estável, defina aqui.
AUDIT_IP_SALT=

# (Opcional) Limite de mensagens por minuto por IP no /api/chat (padrão 20)
CHAT_RATE_LIMIT=20

# (Opcional) Limite de tokens de saída do Gemini (padrão 1024)
GEMINI_MAX_OUTPUT_TOKENS=1024

# (Opcional) Timeout de requisição ao Gemini em ms (padrão 30000)
GEMINI_TIMEOUT_MS=30000

# (Opcional) Ambiente — define cache de assets estáticos
NODE_ENV=production
